# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your-openai-api-key
LLM_QWEN_MAX=deepseek-v4-flash

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=your-tavily-api-key

# RAGFlow 配置
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=your-ragflow-api-key

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# 宿主机连接端口；Compose 内部后端会覆盖为 mysql:3306
MYSQL_PORT=3307
# 宿主机连接端口；Compose 内部后端会覆盖为 redis:6379
REDIS_PORT=6380
# 本机运行后端时可按需配置；Compose 会覆盖为 redis://redis:6379/0
# REDIS_URL=redis://127.0.0.1:6380/0

# Docker 宿主机端口
FRONTEND_PORT=5173
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# 认证配置
AUTH_SESSION_TTL_SECONDS=604800
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_COOKIE_SECURE=false
# 浏览器前端地址，多个地址用英文逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 用户长期记忆策略（第一版为结构化 Redis Store 查询）
MEMORY_MAX_CONTENT_LENGTH=2000
MEMORY_MAX_RESULTS=20
MEMORY_MAX_QUERY_LENGTH=500
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
